{
  "name": "cue-even-g2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cue — Hands-free Chief-of-Staff HUD for Even Realities G2 (AI Assistants & Work + Two-Way Telegram Integration)",
  "scripts": {
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "pack:ehpk": "evenhub pack app.json dist -o cue-g2.ehpk --sdk-ver 0.0.16",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@evenrealities/evenhub-simulator": "^0.9.5"
  }
}
