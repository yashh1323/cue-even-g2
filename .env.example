# Cue Backend Gateway Configuration (Optional — works offline with Sandbox Workspace out of the box)
PORT=8787

# Telegram Bot API (from @BotFather — enables live /pair <code>, incoming DM alerts, replies & action receipts)
TELEGRAM_BOT_TOKEN=

# AI Provider (any one enables live LLM compression, smart drafts & voice intent; falls back to deterministic rules when unset)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Notion REST API (fetches open sprint tasks & creates real tasks on one-tap commit)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Google Calendar Private ICS URL (read-only live next-meeting feed without WebView Google Sign-In)
GOOGLE_CALENDAR_ICS_URL=
